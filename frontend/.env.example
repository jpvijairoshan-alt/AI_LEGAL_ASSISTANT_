# Copy to .env and fill in. URL-encode special characters in the password (@ -> %40).
DATABASE_URL="postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/legal_case_db?schema=public"
# Random 32+ byte value, e.g. PowerShell:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]])
# MUST be identical to JWT_SECRET in backend/.env
NEXTAUTH_SECRET="replace-with-random-32-plus-bytes"
NEXTAUTH_URL="http://localhost:3000"
# Server-side only (used by the /api/backend rewrite). Do NOT prefix with NEXT_PUBLIC_.
BACKEND_URL="http://localhost:8000"
